# .env.example
# Copy this file to .env and fill in your values

# ============================================================================
# ANDROID DEVICE CONFIGURATION
# ============================================================================

# IP address of your Android device (for wireless connection or Waydroid)
# Leave empty to connect to the first USB device found
# Format: IP:PORT (e.g., 192.168.1.100:5555)
ANDROID_DEVICE_IP=

# PIN code for the HondaLink app (if required by your app configuration)
# Must be exactly 4 digits
PIN_CODE=

# HondaLink app package name (usually doesn't need changing)
HONDALINK_PACKAGE=com.honda.hondalink.connect

# Launcher activity (usually doesn't need changing)
HONDALINK_LAUNCHER_ACTIVITY=com.honda.common.module.splash.view.activity.SplashActivity

# Use mock driver for testing without a real Android device
# Set to true for running tests or development without hardware
USE_MOCK_DRIVER=false

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# REQUIRE AUTHENTICATION FOR ALL ENDPOINTS (Recommended: true)
# Set to false ONLY for local testing on isolated networks
REQUIRE_AUTHENTICATION=true

# API KEYS (comma-separated list)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: key1,key2,key3
# KEEP THESE SECRET! Never commit actual keys to git
API_KEYS=

# IP WHITELIST (comma-separated list)
# Leave empty to allow all IPs (not recommended for production)
# Examples:
#   - Single IP: 192.168.1.100
#   - Multiple IPs: 192.168.1.100,192.168.1.50
#   - CIDR notation: 192.168.1.0/24
#   - Mix: 192.168.1.0/24,10.0.0.5
ALLOWED_IPS=

# RATE LIMITING
# Enable rate limiting to prevent abuse
ENABLE_RATE_LIMITING=true

# Maximum API requests per minute per IP (for /status, /debug endpoints)
API_RATE_LIMIT=30

# Maximum vehicle command requests per minute per IP (for /action/* endpoints)
# This should be lower to prevent rapid-fire vehicle commands
COMMAND_RATE_LIMIT=10

# AUDIT LOGGING
# Path to security audit log file (JSONL format)
# All vehicle commands and security events are logged here
AUDIT_LOG_FILE=logs/security_audit.jsonl

# ============================================================================
# JWT CONFIGURATION (Optional - for future token-based authentication)
# ============================================================================

# Secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# KEEP THIS SECRET! Never commit actual key to git
JWT_SECRET_KEY=

# JWT algorithm (recommended: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration time in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# TLS/HTTPS CONFIGURATION
# ============================================================================

# Path to SSL certificate file (for HTTPS)
# Generate self-signed cert with:
#   openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout key.pem -out cert.pem -days 365 \
#     -subj "/CN=localhost"
# For production, use proper CA-signed certificates (Let's Encrypt, etc.)
SSL_CERTFILE=

# Path to SSL private key file (for HTTPS)
SSL_KEYFILE=

# ============================================================================
# QUICK START EXAMPLES
# ============================================================================

# EXAMPLE 1: Maximum Security (Recommended)
# REQUIRE_AUTHENTICATION=true
# API_KEYS=your-generated-key-here
# ALLOWED_IPS=192.168.1.0/24
# ENABLE_RATE_LIMITING=true
# Run with: uvicorn ... --ssl-keyfile=key.pem --ssl-certfile=cert.pem

# EXAMPLE 2: Home Network (Moderate Security)
# REQUIRE_AUTHENTICATION=true
# API_KEYS=your-generated-key-here
# ALLOWED_IPS=192.168.1.0/24
# ENABLE_RATE_LIMITING=true

# EXAMPLE 3: Local Testing Only (Minimal Security - DO NOT USE IN PRODUCTION)
# REQUIRE_AUTHENTICATION=false
# ALLOWED_IPS=127.0.0.1
# ENABLE_RATE_LIMITING=false
